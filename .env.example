# Used by Compose; shell variables configure local Django directly.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=replace-with-your-generated-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SQLITE_PATH=data/splitly.sqlite3
DJANGO_SECURE_COOKIES=false
